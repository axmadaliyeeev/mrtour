# ─── Frontend Environment Variables ───────────────────
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local
#
# This is a Vite app — only vars prefixed VITE_ are exposed to client
# code (via import.meta.env.VITE_*). This file previously used
# NEXT_PUBLIC_ names left over from an earlier Next.js iteration of this
# project, and referenced a Google Maps key / Anthropic key that no code
# here actually reads — cleaned up to match what's real.

# Backend API URL
# Development:
VITE_API_URL=http://localhost:5000/api
# Production (set this in the Vercel dashboard's Environment Variables,
# not in this file):
# VITE_API_URL=https://karvon-backend-6n7n.onrender.com/api

# Google Sign-In (Google Identity Services) — Client ID only. This is a
# public identifier, safe to expose in client code; it is NOT the client
# secret (that lives only in backend/.env, never in frontend code).
# Get it from Google Cloud Console → APIs & Services → Credentials.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
