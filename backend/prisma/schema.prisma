generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  surname      String
  email        String     @unique
  // Optional now: a Google-authenticated account has no password to
  // hash. Email/password registration still always sets this; the
  // login flow's bcrypt.compare guards against it being null for a
  // Google-only account (see auth.service.ts).
  passwordHash String?
  // Kept as a column even though Google sign-in was removed from the UI:
  // dropping it would be a destructive migration for no benefit, and any
  // account that was created through it still needs its row to be valid.
  googleId     String?    @unique
  // Registration now creates the account first, then requires a code sent
  // to this address before login is allowed. See auth.service.ts.
  emailVerified Boolean   @default(false)
  country      String     @default("")
  lang         String     @default("uz")
  isPremium    Boolean    @default(false)
  refreshToken String?
  preferences  String[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reviews      Review[]
  plan         UserPlan[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  // The code is stored hashed, never in plaintext — a database leak
  // shouldn't hand over live codes. Short TTL + the attempts cap below
  // cover the fact that a 6-digit space is small enough to brute-force
  // offline if the hash alone were the only defence.
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model Location {
  id            String     @id @default(cuid())
  name          String
  city          String
  region        String
  category      Category
  rating        Float      @default(0)
  reviewCount   Int        @default(0)
  images        String[]
  tags          String[]
  shortDesc     String?
  fullDesc      String?
  transport     String?
  hours         String?
  price         String?
  priceUSD      Float      @default(0)
  googleMapsUrl String?
  bestSeason    String?
  duration      String?
  featured      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  reviews       Review[]
  userPlans     UserPlan[]

  @@index([city])
  @@index([category])
  @@index([featured])
  @@index([rating])
}

model UserPlan {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

model Review {
  id         String   @id @default(cuid())
  locationId String
  userId     String?
  author     String
  country    String   @default("🌍")
  text       String
  stars      Int
  trustScore Int      @default(0)
  aiTags     String[]
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([locationId])
  @@index([createdAt])
}

enum Category {
  tarix
  tabiat
  madaniyat
  din
  arxeologiya
}
