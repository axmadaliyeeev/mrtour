NODE_ENV=development
PORT=5000

# Neon PostgreSQL (neon.tech → Create project → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Groq (console.groq.com) — this is what src/modules/ai/ai.service.ts
# actually calls (OpenAI-compatible client pointed at Groq's endpoint).
# The previous ANTHROPIC_API_KEY line here was stale/unused — no code
# in this repo reads it.
GROQ_API_KEY=gsk_your-groq-api-key-here

# Google Sign-In (console.cloud.google.com → APIs & Services → Credentials)
# Only the Client ID is needed here — verifying a Google Identity
# Services ID token (what the frontend sends) only requires the Client
# ID as the expected audience. The Client Secret is only needed for the
# server-side authorization-code exchange flow, which this app doesn't
# use, so it is NOT required as a backend env var for this feature.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=minimum_32_characters_change_this_in_production
JWT_REFRESH_SECRET=another_32_char_secret_different_from_above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
