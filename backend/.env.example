# ─── Backend Environment Variables ────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env
# NEVER commit .env to git!

# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/mrtour
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mrtour?retryWrites=true&w=majority

# ── JWT Secrets ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=minimum_32_characters_change_this_in_production_abc123
JWT_REFRESH_SECRET=another_32_char_secret_different_from_above_xyz789

# Token expiry (ms format or shorthand: 15m, 7d, 1h)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Anthropic Claude AI ────────────────────────────────
# Get your key at: https://console.anthropic.com/
# Required for: AI chat (Bek), review analysis, tour plan generation
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── CORS ───────────────────────────────────────────────
# Development:
FRONTEND_URL=http://localhost:3000
# Production (your Vercel domain):
# FRONTEND_URL=https://mrtour.vercel.app

# ── Optional: Cloudinary (image uploads) ──────────────
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
