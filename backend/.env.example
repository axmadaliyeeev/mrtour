NODE_ENV=development
PORT=5000

# Neon PostgreSQL (neon.tech → Create project → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Groq (console.groq.com) — this is what src/modules/ai/ai.service.ts
# actually calls (OpenAI-compatible client pointed at Groq's endpoint).
# The previous ANTHROPIC_API_KEY line here was stale/unused — no code
# in this repo reads it.
GROQ_API_KEY=gsk_your-groq-api-key-here

# Email verification codes — Gmail SMTP.
# SMTP_PASS is NOT your Google password: create an App Password at
# myaccount.google.com > Security > 2-Step Verification > App passwords
# (2FA must be enabled first). Leave both blank in development and the
# server prints codes to its console instead of sending mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=trova <your.address@gmail.com>

# JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=minimum_32_characters_change_this_in_production
JWT_REFRESH_SECRET=another_32_char_secret_different_from_above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed CORS origin(s). Accepts a comma-separated list — use that to
# cover a custom domain and/or Vercel preview deployments alongside the
# main one. Must match the deployed frontend byte-for-byte (no trailing
# slash needed, it is stripped automatically).
#   Production example:
#   FRONTEND_URL=https://trovatour.vercel.app
FRONTEND_URL=http://localhost:3000
