NODE_ENV=development
PORT=5000

# Neon PostgreSQL (neon.tech → Create project → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Anthropic Claude AI (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=minimum_32_characters_change_this_in_production
JWT_REFRESH_SECRET=another_32_char_secret_different_from_above
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
